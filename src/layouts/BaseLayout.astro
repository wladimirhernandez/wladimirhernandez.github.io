---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { profileText } from '../i18n/content';
import { LANG_STORAGE_KEY, langs, localizePath, stripLang, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}

const { lang, title, description = profileText[lang].summary } = Astro.props;
const path = stripLang(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const route = path === '/' ? 'home' : 'inner';
const alternates = langs.map((code) => ({ code, href: new URL(localizePath(code, path), Astro.site).href }));
---

<!doctype html>
<html lang={lang} data-route={route} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <link rel="preload" href="/fonts/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!--
      First visit only: a Spanish-speaking browser on an English page goes to the
      Spanish version. Any explicit choice made with the switcher is stored and
      wins. Runs before paint so there is no flash of the wrong language.
    -->
    <script is:inline define:vars={{ storageKey: LANG_STORAGE_KEY }}>
      try {
        const saved = localStorage.getItem(storageKey);
        const browser = (navigator.languages && navigator.languages[0]) || navigator.language || '';
        if (!saved && document.documentElement.lang === 'en' && browser.toLowerCase().startsWith('es')) {
          const spanish = document.querySelector('link[rel="alternate"][hreflang="es"]');
          if (spanish) location.replace(new URL(spanish.href).pathname + location.search + location.hash);
        }
      } catch {
        // Storage can be blocked; detection is a convenience only.
      }
    </script>
    <ClientRouter />
  </head>
  <body>
    <Header lang={lang} />

    <!-- Holds a frozen copy of the outgoing page during navigation (see scripts/motion.ts). -->
    <div id="curtain" class="curtain" transition:persist="curtain" aria-hidden="true"></div>

    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
        <Footer lang={lang} />
      </div>
    </div>

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  .curtain {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 40;
    block-size: 0;
    overflow: hidden;
    visibility: hidden;
    background-color: var(--color-theme-black);
    pointer-events: none;
  }
</style>
