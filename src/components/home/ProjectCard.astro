---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { localizePath, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  project: { id: string; data: CollectionEntry<'projects'>['data'] };
  lang: Lang;
  /** The first cards are above the fold: load them eagerly. */
  eager?: boolean;
}

const { project, lang, eager = false } = Astro.props;
const t = useTranslations(lang);
const { title, tagline, tags, card, cardAlt, cardPosition, flag } = project.data;
---

<!--
  Grid card. The hover (image clips up to make room for the caption, image
  zooms, caption slides in) is pure CSS so it also works on keyboard focus.
  The home script measures the caption into --caption-h.
-->
<a href={localizePath(lang, `/work/${project.id}`)} class="project-card" data-card>
  <div class="project-card__media">
    <Image
      src={card}
      alt={cardAlt}
      widths={[360, 540, 720, 960]}
      sizes="(min-width: 1380px) 18vw, (min-width: 1024px) 23vw, (min-width: 800px) 31vw, (min-width: 640px) 48vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="project-card__image"
      style={`object-position: ${cardPosition}`}
    />
  </div>

  {
    flag && (
      <span class="project-card__flag">
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0l1.6 3.2L13 2l-1.2 3.4L15 7l-3.2 1.6L13 12l-3.4-1.2L8 14l-1.6-3.2L3 12l1.2-3.4L1 7l3.2-1.6L3 2l3.4 1.2z"
          />
        </svg>
        {t(`flag.${flag}`)}
      </span>
    )
  }

  <div class="project-card__caption" data-caption>
    <ul class="project-card__tags" aria-label={t('card.tags')}>
      {tags.slice(0, 3).map((tag) => <li class="project-card__tag">{tag}</li>)}
    </ul>
    <p class="project-card__title">
      <span class="font-medium">{title}</span>
      <span class="project-card__arrow" aria-hidden="true">&rarr;</span>
      <span class="project-card__tagline">{tagline}</span>
    </p>
  </div>
</a>

<style>
  .project-card {
    --ease: cubic-bezier(0.77, 0, 0.175, 1); /* ≈ power4.inOut */
    --caption-h: 32%;
    position: relative;
    display: block;
    aspect-ratio: 3 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: var(--color-theme-black);
    color: var(--color-theme-light);
    text-decoration: none;
    outline-offset: 4px;
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-theme-light);
  }

  .project-card__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    /* At rest (touch, small screens): the caption always has its space. */
    clip-path: inset(0 0 var(--caption-h) 0.001px round var(--radius-card));
    transition: clip-path 0.5s var(--ease);
  }

  .project-card__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .project-card__flag {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border-radius: 9999px;
    background-color: var(--color-theme-badge);
    backdrop-filter: blur(6px);
    font-size: var(--text-chip);
    font-weight: 600;
    line-height: 1;
  }

  .project-card__caption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 1rem 0.75rem 0.75rem;
    font-size: 1.5rem;
    line-height: 1;
    transition:
      transform 0.5s var(--ease),
      opacity 0.5s var(--ease);
  }

  .project-card__tags {
    display: flex;
    gap: 0.25rem;
    margin-block-end: 0.625rem;
    overflow: hidden;
  }

  .project-card__tag {
    flex: none;
  }

  .project-card__tag {
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-chip);
    background-color: var(--color-theme-gray);
    font-size: var(--text-chip);
    font-weight: 600;
  }

  .project-card__arrow {
    font-weight: 300;
    opacity: 0.4;
  }

  .project-card__tagline {
    font-size: 0.9em;
    opacity: 0.4;
  }

  /* Pointer devices from md up: caption hidden until hover or focus. */
  @media (hover: hover) and (width >= 50rem) {
    .project-card__media {
      clip-path: inset(0 0 0 0.001px round var(--radius-card));
    }

    .project-card__caption {
      opacity: 0;
      transform: translateY(50%);
    }

    .project-card:is(:hover, :focus-visible) .project-card__media {
      clip-path: inset(0 0 var(--caption-h) 0.001px round var(--radius-card));
    }

    .project-card:is(:hover, :focus-visible) .project-card__image {
      transform: scale(1.1);
    }

    .project-card:is(:hover, :focus-visible) .project-card__caption {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (width >= 50rem) {
    .project-card__caption {
      font-size: 2.5vw;
    }
  }

  @media (width >= 64rem) {
    .project-card__caption {
      font-size: 2vw;
    }
  }

  @media (width >= 86.25rem) {
    .project-card__caption {
      font-size: 1.25vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__media,
    .project-card__image,
    .project-card__caption {
      transition: none;
    }
  }
</style>
