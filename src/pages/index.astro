---
import { getCollection } from 'astro:content';
import Hero from '../components/home/Hero.astro';
import ProjectCard from '../components/home/ProjectCard.astro';
import ProjectRow from '../components/home/ProjectRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`${profile.name} | ${profile.role}`}>
  <main data-page="home">
    <Hero />

    <section class="home-work" aria-label="Selected work">
      <!--
        Grid view. Without JS this is a plain CSS grid; the home script
        redistributes the cards into staggered columns for the parallax.
      -->
      <div class="home-grid" data-view="grid" data-grid>
        {projects.map((project, index) => <ProjectCard project={project} eager={index < 4} />)}
      </div>

      <div class="home-list" data-view="list" hidden>
        <ul class="flex flex-col gap-1">
          {
            projects.map((project) => (
              <li>
                <ProjectRow project={project} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import '../scripts/home';
</script>

<style>
  .home-work {
    position: relative;
    z-index: 1;
  }

  .home-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 1), minmax(0, 1fr));
    gap: var(--spacing-gutter);
    max-inline-size: var(--container-grid);
    margin-inline: auto;
    padding: var(--spacing-gutter);
    align-items: start;
  }

  .home-list {
    max-inline-size: var(--container-grid);
    margin-inline: auto;
    padding: var(--spacing-gutter);
  }

  @media (width >= 40rem) {
    .home-grid {
      --cols: 2;
    }
  }

  @media (width >= 50rem) {
    .home-grid {
      --cols: 3;
    }
  }

  @media (width >= 64rem) {
    .home-grid {
      --cols: 4;
    }
  }

  @media (width >= 86.25rem) {
    .home-grid {
      --cols: 5;
    }
  }

  /* Column wrappers created by the home script. */
  .home-grid :global(.grid-col) {
    min-inline-size: 0;
  }

  .home-grid :global(.grid-col-inner) {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gutter);
  }
</style>
