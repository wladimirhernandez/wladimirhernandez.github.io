---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<!-- Placeholder content until T07 builds the hero and the project grid. -->
<BaseLayout title={profile.name}>
  <main class="mx-auto max-w-grid px-14 pt-44">
    <h1 class="text-2xl md:text-3xl lg:text-heading">{profile.name}</h1>
    <p class="mt-4 text-body text-theme-dark-gray/40">{profile.role}</p>
    <div class="mt-24 grid gap-gutter md:grid-cols-3 lg:grid-cols-4" aria-hidden="true">
      {Array.from({ length: 12 }, () => <div class="aspect-3/5 rounded-card bg-theme-gray" />)}
    </div>
  </main>
</BaseLayout>
