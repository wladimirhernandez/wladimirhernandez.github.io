---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const monthFormat = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

/** "2022-10" -> "Oct 2022". */
function formatMonth(value: string): string {
  const [year, month] = value.split('-').map(Number);
  return monthFormat.format(new Date(Date.UTC(year, month - 1, 1)));
}

function formatRange(start: string, end: string | null): string {
  return `${formatMonth(start)} – ${end ? formatMonth(end) : 'Present'}`;
}

const experience = (await getCollection('experience'))
  .map((entry) => entry.data)
  .sort((a, b) => b.start.localeCompare(a.start));

const current = experience.find((entry) => entry.end === null);

const skillGroups = Object.entries(profile.skills).map(([key, items]) => ({
  label: key.charAt(0).toUpperCase() + key.slice(1),
  items,
}));

const educationYears = `${profile.education.start.slice(0, 4)} – ${profile.education.end.slice(0, 4)}`;

const links = [
  { label: 'LinkedIn', href: profile.contact.linkedin },
  { label: 'GitHub', href: profile.contact.github },
];

const headingClass = 'mb-6 text-body font-semibold text-theme-dark-gray/60';
const linkClass =
  'underline decoration-theme-dark-gray/40 underline-offset-4 transition-colors hover:decoration-current focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-theme-light';
---

<BaseLayout title={`About | ${profile.name}`} description={profile.summary}>
  <main data-page="about" class="px-5 pt-36 pb-24 text-white md:px-10 md:pt-48 md:pb-32">
    <!-- Lead statement with the current role aside. -->
    <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_16rem] md:gap-gutter lg:grid-cols-[minmax(0,1fr)_20rem]">
      <h1 data-lead class="max-w-[60rem] text-2xl leading-[1.15] font-normal tracking-[-0.3px] md:text-3xl md:leading-[1.15] lg:text-heading lg:leading-[1.15]">
        <span class="font-semibold">{profile.name}</span> is a {profile.role} building scalable web applications
        and automating business processes since 2018, shipping projects for startups and digital agencies.
      </h1>
      <aside data-lead class="text-body font-semibold md:pt-2" aria-label="Current role">
        {current && (
          <p>
            {current.role} at {current.company}
          </p>
        )}
        <p class="text-theme-dark-gray/60">{profile.location}</p>
      </aside>
    </div>

    <!-- Experience -->
    <section class="mt-24 md:mt-36" aria-labelledby="about-experience">
      <h2 id="about-experience" class={headingClass} data-reveal>Experience</h2>
      <ol class="max-w-[60rem] border-t border-theme-gray">
        {experience.map((entry) => (
          <li class="grid gap-2 border-b border-theme-gray py-6 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-gutter" data-reveal>
            <p class="text-body text-theme-dark-gray/60">
              {formatRange(entry.start, entry.end)}
            </p>
            <div>
              <h3 class="text-lead font-medium">
                {entry.role}
                <span class="text-theme-dark-gray/60"> · {entry.company}</span>
              </h3>
              {entry.highlights.length > 0 && (
                <ul class="mt-3 flex flex-col gap-2 text-body">
                  {entry.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Skills -->
    <section class="mt-24 md:mt-36" aria-labelledby="about-skills">
      <h2 id="about-skills" class={headingClass} data-reveal>Skills</h2>
      <div class="grid max-w-[60rem] grid-cols-2 gap-x-gutter gap-y-8 md:grid-cols-3 lg:grid-cols-5">
        {skillGroups.map((group) => (
          <div data-reveal>
            <h3 class="mb-2 text-body font-semibold">{group.label}</h3>
            <ul class="text-body">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Education, certifications and spoken languages -->
    <div class="mt-24 grid max-w-[60rem] gap-16 md:mt-36 md:grid-cols-2 md:gap-gutter">
      <div class="flex flex-col gap-12" data-reveal>
      <section aria-labelledby="about-education">
        <h2 id="about-education" class={headingClass}>Education</h2>
        <p class="text-body font-semibold">{profile.education.degree}</p>
        <p class="text-body">{profile.education.institution}</p>
        <p class="text-body text-theme-dark-gray/60">
          {profile.education.location}, {educationYears}
        </p>
      </section>

      <section aria-labelledby="about-languages">
        <h2 id="about-languages" class={headingClass}>Languages</h2>
        <ul class="text-body">
          {profile.spokenLanguages.map((entry) => (
            <li>
              {entry.language} <span class="text-theme-dark-gray/60">· {entry.level}</span>
            </li>
          ))}
        </ul>
      </section>
      </div>

      <section aria-labelledby="about-certifications" data-reveal>
        <h2 id="about-certifications" class={headingClass}>Certifications</h2>
        <ul class="flex flex-col gap-3 text-body">
          {profile.certifications.map((cert) => (
            <li>
              <span class="font-semibold">{cert.name}</span>
              <span class="block text-theme-dark-gray/60">
                {cert.issuer}, {cert.year}
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <!-- Closing -->
    <section class="mt-24 md:mt-36" aria-labelledby="about-contact" data-reveal>
      <h2 id="about-contact" class="sr-only">Contact</h2>
      <p class="text-lead font-medium">Let's build something.</p>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-body">
        <li>
          <a class={`${linkClass} break-all`} href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
        </li>
        {links.map((link) => (
          <li>
            <a class={linkClass} href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { onPage, prefersReducedMotion } from '../scripts/motion';

  const REVEAL = { duration: 1, ease: 'power3.out' } as const;

  onPage('[data-page="about"]', () => {
    if (prefersReducedMotion()) return;

    const lead = gsap.utils.toArray<HTMLElement>('[data-page="about"] [data-lead]');
    gsap.fromTo(lead, { opacity: 0, y: 40 }, { opacity: 1, y: 0, delay: 0.25, stagger: 0.1, ...REVEAL });

    gsap.utils.toArray<HTMLElement>('[data-page="about"] [data-reveal]').forEach((element) => {
      gsap.fromTo(
        element,
        { opacity: 0, y: 40 },
        {
          opacity: 1,
          y: 0,
          ...REVEAL,
          scrollTrigger: { trigger: element, start: 'top 85%', once: true },
        },
      );
    });
  });
</script>
